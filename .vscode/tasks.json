{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build APK (Debug)",
            "type": "shell",
            "command": "./gradlew assembleDebug",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gradle"]
        },
        {
            "label": "Clean Project",
            "type": "shell",
            "command": "./gradlew clean",
            "problemMatcher": ["$gradle"]
        },
        {
            "label": "Install APK to Connected Phone (ADB)",
            "type": "shell",
            "command": "adb install -r app/build/outputs/apk/debug/app-debug.apk",
            "problemMatcher": []
        }
    ]
}
