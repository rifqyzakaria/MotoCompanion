    <!-- Dialogs & Bike Guide -->
    <string name="guide_title">🏍️ Connect to Honda RoadSync (All Bikes)</string>
    <string name="guide_message">Steps to connect motorcycle handlebar buttons to your music:\n\n1. Ensure your phone Bluetooth is connected to your Honda motorcycle (PCX, ADV, Forza, Hornet, Transalp, CB, etc.) &amp; Helmet Intercom.\n\n2. Open the official Honda RoadSync app.\n\n3. Go to Settings ➔ Music Source.\n\n4. Select \'Spotify\' (H-Sync) as the music source!\n\n5. In H-Sync, choose your desired music player (BitChord, YouTube Music, etc.).\n\n6. Done! While riding, your Honda handlebar buttons will directly control tracks and song titles will appear on your TFT display!</string>
    <string name="guide_btn_open">Open RoadSync Now</string>
    <string name="guide_btn_close">Close</string>
