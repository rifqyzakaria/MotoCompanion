<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_bg"
    android:keepScreenOn="true"
    android:padding="20dp">

    <!-- Top Bar: Clock & GPS Accuracy -->
    <TextView
        android:id="@+id/tvHudClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:00"
        android:textColor="@color/hud_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvActivePlayerHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🎵 Pemutar: -"
        android:textColor="@color/hud_accent_cyan"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@+id/tvGpsAccuracy"
        app:layout_constraintStart_toEndOf="@+id/tvHudClock"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvGpsAccuracy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="GPS: Akurasi ±3m"
        android:textColor="@color/hud_accent_green"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Center Left: Huge Speedometer -->
    <LinearLayout
        android:id="@+id/layoutSpeedometer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomBar"
        app:layout_constraintEnd_toStartOf="@+id/layoutCompass"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHudClock">

        <TextView
            android:id="@+id/tvSpeedValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="0"
            android:textColor="@color/hud_accent_cyan"
            android:textSize="100sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text="@string/hud_speed_unit"
            android:textColor="@color/hud_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Center Right: Stabilized Heading Compass -->
    <LinearLayout
        android:id="@+id/layoutCompass"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/layoutBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/layoutSpeedometer"
        app:layout_constraintTop_toBottomOf="@+id/tvGpsAccuracy">

        <!-- Compass Needle Container -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_rounded_card">

            <ImageView
                android:id="@+id/ivCompassNeedle"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center"
                android:contentDescription="Compass Needle"
                android:src="@drawable/ic_compass_needle" />
        </FrameLayout>

        <!-- Cardinal & Degrees -->
        <TextView
            android:id="@+id/tvCardinalDirection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="U (Utara)"
            android:textColor="@color/hud_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBearingDegrees"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="000°"
            android:textColor="@color/hud_accent_cyan"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Bar: Media Controls & Status -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvAltitude"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ketinggian: - mdpl"
            android:textColor="@color/hud_text_secondary"
            android:textSize="12sp" />

        <!-- Quick Media Bar (Rider Friendly) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnHudPrev"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:text="◀"
                android:textColor="@color/hud_text_primary"
                app:strokeColor="@color/border_color" />

            <Button
                android:id="@+id/btnHudPlayPause"
                android:layout_width="70dp"
                android:layout_height="46dp"
                android:backgroundTint="@color/accent_cyan"
                android:text="⏯"
                android:textColor="#0D1117"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnHudNext"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:text="▶"
                android:textColor="@color/hud_text_primary"
                app:strokeColor="@color/border_color" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCloseHud"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/hud_exit"
            android:textColor="@color/accent_red" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
